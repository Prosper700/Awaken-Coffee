<header class="full-width">
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      {{ 'icon-account.svg' | inline_asset_content | link_to: routes.account_url }}
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    min-height: 5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 24px;
    background: var(--awaken-dark);
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--awaken-tan);
    transition: color 0.2s;
  }
  header a:hover { color: var(--awaken-gold); }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
    color: var(--awaken-gold);
  }
  header svg { width: 1.75rem; }

  header .header__menu {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
  }
  header .header__title {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-family: var(--awaken-font-heading);
    font-size: 2rem;
    line-height: 1;
    text-align: center;
  }
  header .header__title a { color: var(--awaken-cream); }
  header .header__icons {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    gap: 1rem;
    justify-self: end;
  }

  @media (max-width: 749px) {
    header {
      grid-template-columns: 1fr auto;
      padding: 12px 16px;
      row-gap: 8px;
    }
    header .header__title { grid-column: 1; grid-row: 1; text-align: left; }
    header .header__icons { grid-column: 2; grid-row: 1; }
    header .header__menu {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
