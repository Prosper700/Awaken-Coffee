<section class="awaken-testimonials full-width">
  <div class="awaken-testimonials__inner">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="awaken-testimonials__grid">
      {% for block in section.blocks %}
        <figure class="awaken-testimonials__card" {{ block.shopify_attributes }}>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.author }}</strong>
            {% if block.settings.location != blank %}
              <span>{{ block.settings.location }}</span>
            {% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .awaken-testimonials { background: var(--awaken-cream); padding: 48px 20px; }
  .awaken-testimonials__inner { max-width: 1100px; margin: 0 auto; }
  .awaken-testimonials h2 {
    font-family: var(--awaken-font-heading);
    font-size: 2.25rem;
    color: var(--awaken-dark);
    margin: 0 0 24px;
  }
  .awaken-testimonials__grid { display: grid; gap: 20px; }
  @media (min-width: 750px) {
    .awaken-testimonials__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .awaken-testimonials__card {
    margin: 0;
    padding: 24px;
    background: #fff8ee;
    border: 1px solid var(--awaken-gold);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .awaken-testimonials blockquote {
    margin: 0;
    line-height: 1.7;
    color: var(--awaken-dark);
  }
  .awaken-testimonials figcaption { display: flex; flex-direction: column; color: var(--awaken-brown); }
  .awaken-testimonials figcaption span { font-size: 0.875rem; opacity: 0.8; }
{% endstylesheet %}

{% schema %}
{
  "name": "Awaken testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Smooth, rich and never bitter." },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "location", "label": "Location" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Awaken testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Smooth, rich and never bitter. It changed my mornings.", "author": "Sample Customer", "location": "Abuja" } },
        { "type": "testimonial", "settings": { "quote": "The House Blend arrived fresh and smelled amazing.", "author": "Sample Customer", "location": "Lagos" } },
        { "type": "testimonial", "settings": { "quote": "Fast delivery and the espresso roast is excellent.", "author": "Sample Customer", "location": "Kano" } }
      ]
    }
  ]
}
{% endschema %}